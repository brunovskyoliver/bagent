    "currentChat.clear.changed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current Chat changed in another window. Review it before clearing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のウインドウで現在のチャットが変更されました。消去する前に確認してください。"
          }
        }
      }
    },
    "currentChat.clear.confirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear Current Chat"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のチャットを消去"
          }
        }
      }
    },
    "currentChat.clear.explanation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clears completed and interrupted turns, the draft, attachments, sources, Connector References, approvals, and any Continuation Seed and Provenance. No hidden archive is kept. Automation Sessions, Runs and Definitions, Saved Long-Term Memory, external side effects, and source-session viewed state remain; no Automation Work is cancelled."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了・中断したターン、下書き、添付ファイル、ソース、コネクタ参照、承認、継続シードと来歴を消去します。非表示のアーカイブは残りません。自動化セッション、実行、定義、保存済み長期記憶、外部の副作用、元セッションの閲覧状態は残り、自動化作業はキャンセルされません。"
          }
        }
      }
    },
    "currentChat.clear.failure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Current Chat could not be cleared. Try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のチャットを消去できませんでした。もう一度お試しください。"
          }
        }
      }
    },
    "currentChat.clear.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear Current Chat?"
          }
        },
